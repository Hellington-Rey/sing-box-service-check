            click: function () { setAll(true); },
          }, "Выбрать все"),
          E("button", {
            class: "cbi-button",
            click: function () { setAll(false); },
          }, "Снять все"),
          progressWrap,
          progressText,
        ]),
      ]),
      summaryNode,
      metaNode,
      tilesNode,
      historyPanel,
